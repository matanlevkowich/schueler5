<!DOCTYPE html>
<html class="no-js" lang="en-US">
    <head>
        {% hook "seo" %}
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"> 
        <meta name="referrer" content="origin-when-cross-origin" />
        <link rel="home" href="{{ siteUrl }}" />
        <link href="/assets/favicon.png?v=2" rel="shortcut icon">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        {% do craft.app.view.registerCssFile('https://use.typekit.net/stp6jeb.css') %}
        {% do craft.app.view.registerCssFile('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@200;400;600&display=swap') %}
        {% do craft.app.view.registerCssFile('https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css') %}
        {% do craft.app.view.registerCssFile(version('/interface/css/main.css')) %}
        <script src='/interface/js/load.js?v=1.2'></script>
    </head>
    <body class="ltr">
        
        <header class="header">
            {% include '_layout/header' %}
        </header>
        <main id="content" role="main">
            {% block content %}
                
            {% endblock %}
        </main>
        <footer class="footer">
            {% include "_layout/footer" %}
        </footer> 
        
        {% set popUpDate = popUp.finalDate ?? null %}
        {% if popUpDate and popUpDate > now %}
            {% include '_components/pop-up' %}
        {% endif %}
    
        {% include '_components/cookies' %}
    </body>
    {% do craft.app.view.registerJsFile(version('/interface/js/glightbox.js')) %}
    {% do craft.app.view.registerJsFile('https://unpkg.com/@glidejs/glide@3.7.1/dist/glide.js') %}
    {% do craft.app.view.registerJsFile(version('/interface/js/main.js')) %}
</html>
