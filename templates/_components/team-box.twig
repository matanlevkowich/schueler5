<div class="flex">
   {% set smallCardCounter = 0 %}
   {% for category in categories %}
      {% set smallCardCounter = smallCardCounter + 1 %} {# Increment the counter #}
      <div class="card card--min card--flex">
        <div class="card__small">
          <div class="card__inner">
            <span class="card__number">{% if smallCardCounter <= 9%}0{% endif %}{{ smallCardCounter }}</span> 
            <h1 class="card__title">{{ category.title }}</h1>
          </div>
          <div class="card__text">{{ category.simpleText }}</div>
        </div>
        <div class="card__image">
          {% set image = category.image.one %}
          <img src="{{ image.getUrl }}"/>                  
        </div>
      </div>
   {% endfor %}
</div>
