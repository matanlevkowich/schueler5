{% set selectedTag = craft.app.request.getParam('tag') %}
{% set twoYearsAgo = now|date_modify('-3 years') %}

{% set entriesQuery = craft.entries()
    .section('aktuellesPages')
    .with(['aktuellesTags', 'thumb'])
    .orderBy('postDate DESC')
    .postDate('> ' ~ twoYearsAgo|atom) 
%}
{% if selectedTag %}
    {% set entriesQuery = entriesQuery.relatedTo({
        targetElement: craft.tags().title(selectedTag).one()
    }) %}
{% endif %}
{% set entries = entriesQuery.all() %}
{% if selectedTag %}
    <div class="filter">
        {% include '_components/filter' %}Filter: <strong>{{ selectedTag }}</strong><span> | </span>
        <a class="filter__remove" href="{{ url('aktuelles') }}">
            {% include '_components/filter-remove' %}Zurücksetzen 
        </a>
    </div>
{% endif %}

{% include '_components/aktuelles' with { entries: entries } %}

