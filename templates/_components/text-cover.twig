{% set blocks = entry.textCover.all() %}
{% for block in blocks %}
    <div class="text text--cover {{ extraClass ?? '' }}">
        {% set cover = block.image.one() %}            
        <div class="text__cover" style="background-image: url('{{ cover.getUrl }}'); background-position-y:{{ cover.backgroundPositionY}}%;"></div>
        <div class="text__gradiant"></div>
        <div class="text__outer">
            <div class="text__inner">
                <div class="text__number">{{ textNumber ?? '' }}</div>
                <h1 class="text__title">{{ block.sectionTitle | nl2br }}</h1>
            </div>
                <div class="text__paragraph">{{ block.simpleText }}</div>
                {% if block.ctaButton %}
                    {% set link = block.ctaLink %}
                    {% include '_components/button' with { buttonClass:'button--red', link:link } %}
                {% endif %}
            </div>
        </div>
    </div>
{% endfor %}
