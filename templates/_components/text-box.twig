{% set blocks = entry.textBox.all() %}
{% for block in blocks %}
    <div class="text {{ extraClass ?? '' }}">
            <div class="text__inner">
                <span class="text__number">{{ textNumber ?? '' }}</span>
                <h1 class="text__title">{{ block.sectionTitle | nl2br }}</h1>
            </div>
            <div class="text__paragraph">{{ block.simpleText }}</div>
            {% if block.ctaButton %}
                {% set link = block.ctaLink %}
                {% include '_components/button' with { link:link } %}
            {% endif %}
        </div>
    </div>
{% endfor %}