{% set blocks = entry.cover.all() %}
{% for block in blocks %}
    <div class="cover">
        {% set images = block.images.all() %}            
        <div class="cover__background">
            {% for image in images %}
                {% if image.focalPoint %}
                    {% set focalX = image.focalPoint.x * 100 %}
                    {% set focalY = image.focalPoint.y * 100 %}
                {% endif %}
                <div class="cover__fade {% if loop.first %}cover__fade--active{% endif %}" style="background-image: url('{{ image.getUrl }}'); background-position: {{ focalX }}% {{ focalY }}%;"></div>
            {% endfor %}
        </div>
        <div class="cover__gradiant"></div>
        <div class="cover__text">
            <h1 class="cover__title">{{ block.title }}</h1>
            <div class="cover__subtitle">{{ block.subtitle }}</div>
        </div>
    </div>
{% endfor %}