<div class="pop">
    <div class="pop__background"></div>
    <div class="pop__content">
        <div class="pop__close">{% include '_components/close' %}</div>    
        <h1 class="pop__title">{{ popUp.sectionTitle }}</h1>
        <div class="pop__text">{{ popUp.simpleText }}</div>
        {% set button = popUp.ctaLink ?? null %}
        {% if button %}
            {% include '_components/button' with { link:popUp.ctaLink , buttonClass:'button--red button--margin button--center button--pop'} %}
        {% endif %}
    </div>
</div>