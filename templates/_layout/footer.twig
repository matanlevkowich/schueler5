<div class="footer__box">
	{% include '_layout/logo' with { extraClass: 'logo__footer' } %}
	<div class="footer__copyrights">© {{ now|date('Y') }} ALL RIGHTS RESERVED. ELISABETH RAUTER. </div>
</div>

<div class="footer__box">
	<div class="footer__column">
		<h3 class="footer_title">Menu</h3>
		<a href="{{ siteUrl }}">home</a>
		{% include '_layout/nav' %}
	</div>

	<div class="footer__column">
		<h3 class="footer_title">Legal</h3>
		{% set entries = craft.entries.section('legal').all() %}
		{% for entry in entries %}
			<a href="{{ entry.url }}">{{ entry.title }}</a>
		{% endfor %}
		<h3 class="footer_title">Web Design</h3>
		<a href="https://lessmore.co/" target="_blank">lessmore creative studio</a>
	</div>
</div>

