<a class="header__link" href="{{ siteUrl }}">
    {% include '_layout/logo' with { extraClass: 'logo--header' } %}                    
</a>

<div class="header__nav">
    <div class="header__ham">
        <span class="header__line"></span>
        <span class="header__line"></span>
        <span class="header__line"></span>
    </div>
    <div class="header__lang">    
        {% set element = (category ?? entry ?? null) %}
        <a class='header__langlink' href="{{ siteSwitcher('default', element) }}">de</a>
        <a class='header__langlink'>/</a>
        <a class='header__langlink' href="{{ siteSwitcher('english', element) }}">en</a>
    </div>
</div>

{% include '_layout/nav' with { extraClass: 'nav--header', includeLogo: true } %}                
